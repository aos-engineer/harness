# Dependencies
node_modules/
bun.lock
# The root and site lockfiles are tracked so every checkout, CI, and the site's Docker build resolve the
# same versions.
!/bun.lock
!/site/bun.lock

# AOS session data
.aos/

# Superpowers brainstorm sessions
.superpowers/

# OS files
.DS_Store

# Build output
dist/
# The plugin's bundles are committed: a marketplace installs the plugin straight from git.
!/hosts/claude-code/dist/

# Logs
*.log

# Worktrees
.worktrees/

# Environment / secrets
.env
.env.*
# Signing keys / certs (A2A Agent Card signing) — never commit private key material
*.pem
*.key
*.p8
