---
// Every page says which release it documents and links to the same ground in the other one. 1.0 changed
// what AOS is (a plugin inside Claude Code rather than an orchestrator), so a reader on the wrong line
// would follow instructions for a different product.
import { counterpart, type Version } from '../lib/versions';

interface Props { version: Version }
const { version } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const other = counterpart(path);
---
<aside class="version-banner" data-version={version} aria-label="Release">
  {version === '1.0' ? (
    <p>
      <strong>AOS 1.0</strong> is in prerelease. Still running 0.11?
      <a href={other}>Read the 0.11 docs</a>.
    </p>
  ) : (
    <p>
      You are reading the docs for <strong>AOS 0.11</strong>, the release on npm <code>latest</code>.
      <a href={other}>See AOS 1.0</a>, which runs inside Claude Code as a plugin.
    </p>
  )}
</aside>

<style>
  .version-banner {
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-signal);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 14px;
    line-height: 1.55;
    text-align: left;
  }
  .version-banner[data-version='0.11'] {
    border-left-color: var(--color-warning);
  }
  .version-banner p {
    margin: 0;
  }
  .version-banner strong {
    color: var(--color-text);
  }
  .version-banner code {
    font-size: 0.92em;
  }
  .version-banner a {
    color: var(--color-signal);
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }
  .version-banner a:hover {
    color: var(--color-signal-hover);
  }
</style>
