---
// This site documents the released 0.x line. AOS 1.0 is a different product shape (a plugin inside Claude
// Code rather than an orchestrator), so readers need to know which one they are reading before they
// install anything. The 1.0 docs live in the repository, next to the code they describe.
const GUIDE = 'https://github.com/aos-engineer/harness/blob/main/docs/1.0/getting-started.md';
---
<aside class="preview-notice" aria-label="AOS 1.0 preview">
  <strong>AOS 1.0 preview is out.</strong>
  These pages cover 0.11, the current stable release. 1.0 runs inside Claude Code as a plugin and gates
  pushes, PRs, and deploys on observed evidence and human approvals.
  <a href={GUIDE}>Read the 1.0 getting-started guide</a>.
</aside>

<style>
  .preview-notice {
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-signal);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 14px;
    line-height: 1.55;
    text-align: left;
  }
  .preview-notice strong {
    color: var(--color-text);
  }
  .preview-notice a {
    color: var(--color-signal);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .preview-notice a:hover {
    color: var(--color-signal-hover);
  }
</style>
