---
import VersionBanner from '../components/VersionBanner.astro';
import { REPO, siteGroups, topLinks as linksFor, V011_PREFIX, type Version } from '../lib/versions';

interface Props {
  title: string;
  description?: string;
  version?: Version;
}

const { title, description, version = '0.11' } = Astro.props;
const summary = description ?? (version === '1.0'
  ? 'AOS gates for coding agents: staged runs, observed test evidence, and human approvals inside Claude Code.'
  : 'AOS 0.11: config-driven agent councils and execution teams on top of Claude Code, Codex, Gemini, and Pi.');

const currentPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(currentPath, Astro.site ?? Astro.url).toString();

const navGroups = siteGroups(version).map((g) => ({ title: g.title, links: g.links.map((l) => ({ href: l.href, label: l.title })) }));
const topLinks = linksFor(version);
const home = version === '1.0' ? '/' : `${V011_PREFIX}/`;
const docsHome = version === '1.0' ? '/docs/getting-started/' : `${V011_PREFIX}/docs/getting-started/`;
const tagline = version === '1.0' ? 'Staged gates for coding agents' : 'Agentic orchestration system, 0.11';

function isActive(href: string) {
  if (href === home) {
    return currentPath === home;
  }
  return currentPath.startsWith(href);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={summary} />
    <meta name="theme-color" content="#f7f7f8" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="index,follow" />
    <meta property="og:title" content={`${title} | AOS.engineer`} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title} | AOS.engineer</title>
    <!-- External file (is:inline here means "emit verbatim, don't bundle" — the
         tag still has a src, so CSP `script-src 'self'` allows it, unlike an
         inline script). Render-blocking so the theme is set before first paint. -->
    <script is:inline src="/theme.js"></script>
  </head>
  <body class="site-shell min-h-screen bg-[var(--color-bg)] text-[var(--color-text)]">
    <aside class="docs-rail">
      <a href={home} class="docs-brand" aria-label="AOS home">
        <span class="docs-brand-mark">AOS</span><span>.engineer</span>
      </a>

      <nav class="docs-nav" aria-label="Site">
        {navGroups.map((group) => (
          <section class="docs-nav-group">
            <h2>{group.title}</h2>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.href} class:list={{ active: isActive(link.href) }}>
                    <span>{link.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </nav>
    </aside>

    <header class="docs-header">
      <div class="docs-header-search" aria-hidden="true">
        <span class="docs-search-icon">/</span>
        <span>{tagline}</span>
      </div>

      <div class="docs-mobile-brand">
        <details class="docs-mobile-menu">
          <summary aria-label="Open site navigation">
            <span></span><span></span><span></span>
          </summary>
          <div class="docs-mobile-panel">
            {navGroups.map((group) => (
              <section>
                <h2>{group.title}</h2>
                {group.links.map((link) => (
                  <a href={link.href} class:list={{ active: isActive(link.href) }}>
                    {link.label}
                  </a>
                ))}
              </section>
            ))}
          </div>
        </details>
        <a href={home} class="docs-mobile-logo">AOS<span>.engineer</span></a>
      </div>

      <nav class="docs-top-nav" aria-label="Primary">
        {topLinks.map((link) => (
          <a
            href={link.href}
            class:list={{ active: !link.external && isActive(link.href) }}
            {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <button class="docs-theme-toggle" type="button" aria-label="Toggle dark mode" data-theme-toggle>
        <span class="docs-theme-sun"></span>
        <span class="docs-theme-moon"></span>
      </button>
    </header>

    <main class="site-main">
      <div class="site-version-banner"><VersionBanner version={version} /></div>
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <span class="font-semibold text-[var(--color-text)]">AOS Harness</span>
        <span>{tagline}</span>
      </div>
      <nav aria-label="Footer">
        <a href={docsHome}>Docs</a>
        <a href={version === '1.0' ? `${V011_PREFIX}/` : '/'}>{version === '1.0' ? 'AOS 0.11' : 'AOS 1.0'}</a>
        <a href={REPO} target="_blank" rel="noopener">GitHub</a>
        <span>MIT License</span>
      </nav>
    </footer>

  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
