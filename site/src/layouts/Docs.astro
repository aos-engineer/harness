---
import VersionBanner from '../components/VersionBanner.astro';
import { DOCS_0_11, DOCS_1_0, topLinks as linksFor, V011_PREFIX, type Version } from '../lib/versions';

interface SidebarLink {
  id: string;
  label: string;
}

interface Props {
  title: string;
  description?: string;
  sidebarLinks?: SidebarLink[];
  version?: Version;
}

const { title, description, sidebarLinks = [], version = '0.11' } = Astro.props;
const currentPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(currentPath, Astro.site ?? Astro.url).toString();

const docsGroups = version === '1.0' ? DOCS_1_0 : DOCS_0_11;
const topLinks = linksFor(version);
const docsHome = version === '1.0' ? '/docs/getting-started/' : `${V011_PREFIX}/docs/getting-started/`;
const brandHref = version === '1.0' ? '/' : `${V011_PREFIX}/`;
const siteTitle = version === '1.0' ? 'AOS Docs' : 'AOS 0.11 Docs';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description ?? title} />
    <meta name="theme-color" content="#f7f7f8" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title} | {siteTitle}</title>
    <!-- External file (is:inline here means "emit verbatim, don't bundle" — the
         tag still has a src, so CSP `script-src 'self'` allows it, unlike an
         inline script). Render-blocking so the theme is set before first paint. -->
    <script is:inline src="/theme.js"></script>
  </head>
  <body class="docs-shell min-h-screen bg-[var(--color-bg)] text-[var(--color-text)]">
    <aside class="docs-rail">
      <a href={brandHref} class="docs-brand" aria-label="AOS home">
        <span class="docs-brand-mark">AOS</span><span>.engineer</span>
      </a>

      <nav class="docs-nav" aria-label="Documentation">
        {docsGroups.map((group) => (
          <section class="docs-nav-group">
            <h2>{group.title}</h2>
            <ul>
              {group.links.map((link) => {
                const active = currentPath === link.href;
                return (
                  <li>
                    <a href={link.href} class:list={{ active }}>
                      <span>{link.title}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </nav>
    </aside>

    <header class="docs-header">
      <div class="docs-header-search" aria-hidden="true">
        <span class="docs-search-icon">/</span>
        <span>Search docs</span>
      </div>

      <div class="docs-mobile-brand">
        <details class="docs-mobile-menu">
          <summary aria-label="Open documentation navigation">
            <span></span><span></span><span></span>
          </summary>
          <div class="docs-mobile-panel">
            {docsGroups.map((group) => (
              <section>
                <h2>{group.title}</h2>
                {group.links.map((link) => (
                  <a href={link.href} class:list={{ active: currentPath === link.href }}>
                    {link.title}
                  </a>
                ))}
              </section>
            ))}
          </div>
        </details>
        <a href={brandHref} class="docs-mobile-logo">AOS<span>.engineer</span></a>
      </div>

      <nav class="docs-top-nav" aria-label="Primary">
        {topLinks.map((link) => (
          <a href={link.href} {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}>
            {link.label}
          </a>
        ))}
      </nav>

      <button class="docs-theme-toggle" type="button" aria-label="Toggle dark mode" data-theme-toggle>
        <span class="docs-theme-sun"></span>
        <span class="docs-theme-moon"></span>
      </button>
    </header>

    <div class="docs-page">
      <main class="docs-main">
        <div class="docs-preview-notice"><VersionBanner version={version} /></div>

        <div class="docs-breadcrumb">
          <a href={docsHome}>{version === '1.0' ? 'Docs' : 'Docs 0.11'}</a>
          <span>/</span>
          <span>{title}</span>
        </div>

        {sidebarLinks.length > 0 && (
          <nav class="docs-section-pills" aria-label="On this page">
            {sidebarLinks.map((link) => (
              <a href={`#${link.id}`}>{link.label}</a>
            ))}
          </nav>
        )}

        <article class="docs-article">
          <slot />
        </article>
      </main>

      {sidebarLinks.length > 0 && (
        <aside class="docs-toc" aria-label="On this page">
          <div>
            <h2>On this page</h2>
            <nav>
              {sidebarLinks.map((link) => (
                <a href={`#${link.id}`}>{link.label}</a>
              ))}
            </nav>
          </div>
        </aside>
      )}
    </div>

  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
