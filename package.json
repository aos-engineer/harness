{
  "name": "aos-harness-monorepo",
  "version": "1.0.0-next.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "kernel",
    "hosts/*",
    "packs/*",
    "cli"
  ],
  "scripts": {
    "test": "bun test ./kernel ./hosts ./cli ./tests",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "lint:yaml-safety": "bun run scripts/check-yaml-safety.ts",
    "lint": "bun run lint:yaml-safety && bun run typecheck"
  },
  "devDependencies": {
    "@aos-harness/host-claude-code": "workspace:*",
    "@aos-harness/kernel": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/bun": "^1.3.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "latest",
    "typescript": "^5.8.0"
  }
}
