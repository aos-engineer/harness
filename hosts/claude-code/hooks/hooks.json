{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/bin/aos-hook.ts\" pre-tool-use", "timeout": 15, "onFailure": "block" }]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/bin/aos-hook.ts\" pre-tool-use", "timeout": 15 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Skill|mcp__plugin_aos_aos__aos_run_start",
        "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/bin/aos-hook.ts\" post-tool-use", "timeout": 15 }]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/bin/aos-hook.ts\" post-tool-use-failure", "timeout": 15 }]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/bin/aos-hook.ts\" session-start", "timeout": 15 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/bin/aos-hook.ts\" stop", "timeout": 30 }]
      }
    ]
  }
}
